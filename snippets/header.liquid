<script>
  (function() {
    // 1. Mobile Menu Toggle
    function initMobileMenuToggle() {
      var hamburger = document.querySelector('.hamburger-menu-white');
      var menu = document.querySelector('.nav-buttons-wrapper');
      if (!hamburger || !menu) return;

      hamburger.addEventListener('click', function() {
        menu.classList.toggle('is-open');
      });

      document.addEventListener('click', function(e) {
        if (menu.classList.contains('is-open') && !menu.contains(e.target) && !hamburger.contains(e.target)) {
          menu.classList.remove('is-open');
        }
      });
    }

    // 2. Strict Click-Only Toggle for Products Dropdown (No Hover Activation!)
    function initClickOnlyDropdown() {
      var toggle = document.getElementById('products-dropdown-toggle') || document.querySelector('.dropdown-toggle');
      var list = document.getElementById('products-dropdown-list') || document.querySelector('.dropdown-list');
      if (!toggle || !list) return;

      // Use measured viewport coordinates; the header's backdrop filter means
      // a fixed-position child would still be positioned relative to the header.
      function positionProductsPanel() {
        if (!window.matchMedia('(min-width: 992px)').matches) return;
        var viewport = window.visualViewport;
        var viewportLeft = viewport ? viewport.offsetLeft : 0;
        var viewportTop = viewport ? viewport.offsetTop : 0;
        var viewportWidth = viewport ? viewport.width : document.documentElement.clientWidth;
        var viewportHeight = viewport ? viewport.height : window.innerHeight;
        var gutter = 16;
        list.style.setProperty('--products-panel-width', Math.min(740, viewportWidth - gutter * 2) + 'px');
        list.style.setProperty('--products-panel-left', '0px');
        var rect = list.getBoundingClientRect();
        var desiredLeft = rect.left - 170;
        var safeLeft = Math.max(viewportLeft + gutter,
          Math.min(desiredLeft, viewportLeft + viewportWidth - gutter - rect.width));
        list.style.setProperty('--products-panel-left', (safeLeft - rect.left) + 'px');
        list.style.setProperty('--products-panel-height',
          Math.max(0, viewportTop + viewportHeight - gutter - rect.top) + 'px');
      }

      var positionFrame;
      function scheduleProductsPosition() {
        cancelAnimationFrame(positionFrame);
        positionFrame = requestAnimationFrame(positionProductsPanel);
      }
      window.addEventListener('resize', scheduleProductsPosition);
      if (window.visualViewport) {
        window.visualViewport.addEventListener('resize', scheduleProductsPosition);
        window.visualViewport.addEventListener('scroll', scheduleProductsPosition);
      }
      if (window.ResizeObserver) {
        var headerObserver = new ResizeObserver(scheduleProductsPosition);
        headerObserver.observe(toggle.closest('.nav-bar'));
      }
      positionProductsPanel();

      toggle.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        var isOpen = list.classList.contains('is-open') || list.classList.contains('w--open');
        if (isOpen) {
          list.classList.remove('is-open');
          list.classList.remove('w--open');
          toggle.classList.remove('w--open');
          toggle.setAttribute('aria-expanded', 'false');
        } else {
          list.classList.add('is-open');
          list.classList.add('w--open');
          toggle.classList.add('w--open');
          toggle.setAttribute('aria-expanded', 'true');
          positionProductsPanel();
        }
      });

      document.addEventListener('click', function(e) {
        if (!toggle.contains(e.target) && !list.contains(e.target)) {
          list.classList.remove('is-open');
          list.classList.remove('w--open');
          toggle.classList.remove('w--open');
          toggle.setAttribute('aria-expanded', 'false');
        }
      });
    }

    // 3. Interactive Live Product Preview Handler for Items INSIDE Dropdown
    function initMegaMenuPreview() {
      var dropLinks = document.querySelectorAll('.pmgb-mega-menu__left-card .drop-nav-link');
      var previewImg = document.getElementById('mega-preview-img');
      var previewTitle = document.getElementById('mega-preview-title');
      var previewDesc = document.getElementById('mega-preview-desc');
      var previewSpec = document.getElementById('mega-preview-spec');
      var previewCTA = document.getElementById('mega-preview-cta');

      if (!dropLinks.length || !previewImg) return;

      var preview = document.getElementById('products-preview');
      var list = document.getElementById('products-dropdown-list');
      var mobilePreview = window.matchMedia('(max-width: 991px)');

      function placePreview(link) {
        if (!preview || !list) return;
        if (mobilePreview.matches) {
          link.insertAdjacentElement('afterend', preview);
        } else if (preview.parentElement !== list) {
          list.appendChild(preview);
        }
        dropLinks.forEach(function(item) {
          if (mobilePreview.matches) {
            item.setAttribute('aria-controls', 'products-preview');
            item.setAttribute('aria-expanded', item === link ? 'true' : 'false');
          } else {
            item.removeAttribute('aria-controls');
            item.removeAttribute('aria-expanded');
          }
        });
      }

      function updatePreview(link) {
        dropLinks.forEach(function(l) { l.classList.remove('is-active'); });
        link.classList.add('is-active');

        var img = link.getAttribute('data-img');
        var title = link.getAttribute('data-title');
        var desc = link.getAttribute('data-desc');
        var spec = link.getAttribute('data-spec');
        var url = link.getAttribute('data-url');

        if (img) previewImg.src = img;
        if (title) {
          previewTitle.textContent = title;
          previewImg.alt = title;
        }
        if (desc) previewDesc.textContent = desc;
        if (spec) previewSpec.textContent = spec;
        if (url && previewCTA) previewCTA.href = url;
      }

      var initialActive = document.querySelector('.pmgb-mega-menu__left-card .drop-nav-link.is-active') || dropLinks[0];
      if (initialActive) {
        updatePreview(initialActive);
        placePreview(initialActive);
      }

      dropLinks.forEach(function(link) {
        link.addEventListener('mouseenter', function() {
          updatePreview(this);
          placePreview(this);
        });
        link.addEventListener('focus', function() {
          updatePreview(this);
          placePreview(this);
        });
        link.addEventListener('click', function(event) {
          if (!mobilePreview.matches || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
          event.preventDefault();
          updatePreview(this);
          placePreview(this);
          // Keep the selected row and its details in the existing scrollable drawer.
          var drawer = list.closest('.nav-buttons-wrapper');
          if (drawer) {
            drawer.scrollTop += this.getBoundingClientRect().top - drawer.getBoundingClientRect().top - 12;
          }
        });
      });

      function syncPreviewLayout() {
        var active = Array.prototype.find.call(dropLinks, function(link) {
          return link.classList.contains('is-active');
        }) || dropLinks[0];
        placePreview(active);
      }
      mobilePreview.addEventListener('change', syncPreviewLayout);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function() {
        initMobileMenuToggle();
        initClickOnlyDropdown();
        initMegaMenuPreview();
      });
    } else {
      initMobileMenuToggle();
      initClickOnlyDropdown();
      initMegaMenuPreview();
    }
  })();
</script>
