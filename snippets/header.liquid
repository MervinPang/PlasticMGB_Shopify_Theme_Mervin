    }

    [data-hero-slider-section] .cat-hero--fade .cat-hero__track,
    [data-hero-slider-section] .cat-hero__content-box {
      grid-template-columns: minmax(0, 1fr);
    }

    [data-hero-slider-section] .cat-hero__left-content,
    [data-hero-slider-section] .cat-hero__info-panel-wrap,
    [data-hero-slider-section] .cat-hero__actions,
    [data-hero-slider-section] .cat-hero__trust-badge {
      max-width: 100%;
      min-width: 0;
    }

    [data-hero-slider-section] .cat-hero__headline,
    [data-hero-slider-section] .cat-hero__subtext,
    [data-hero-slider-section] .cat-hero__trust-badge,
    [data-hero-slider-section] .cat-info-slide__content {
      overflow-wrap: anywhere;
    }

    [data-hero-slider-section] .cat-hero__btn,
    [data-hero-slider-section] .cat-spec-chip {
      max-width: 100%;
      white-space: normal;
      overflow-wrap: anywhere;
    }

    [data-hero-slider-section] .cat-info-slide {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    }
  }

  @media screen and (max-width: 640px) {
    [data-hero-slider-section] .cat-hero__btn {
      max-width: min(280px, 100%);
    }

    .procurement-section .procurement-header {
      min-width: 0;
      max-width: 100%;
      padding-left: 16px;
      padding-right: 16px;
      box-sizing: border-box;
      overflow-wrap: anywhere;
    }

    [data-hero-slider-section] .cat-info-slide {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

