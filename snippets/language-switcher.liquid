{%- comment -%}
  Floating Language Switcher snippet.
  Renders a premium, accessible floating globe button and popover language selection menu.
{%- endcomment -%}


{%- comment -%}
<style>
  .float-lang-container {
    position: fixed;
    bottom: 28px;
    right: 28px;
    z-index: 999999;
    font-family: 'Exo', sans-serif;
  }

  /* Prominent Pill Trigger Button */
  .float-lang-btn {
    height: 46px;
    padding: 0 16px 0 12px;
    border-radius: 50px;
    background-color: #133f90;
    border: 2px solid #e8ab3f;
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(19, 63, 144, 0.35);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    position: relative;
    user-select: none;
  }

  .float-lang-btn:hover,
  .float-lang-btn:focus {
    transform: translateY(-3px) scale(1.03);
    background-color: #0f3378;
    border-color: #f59e0b;
    box-shadow: 0 10px 25px rgba(232, 171, 63, 0.45);
    outline: none;
  }

  .float-lang-btn svg.float-globe-icon {
    width: 20px;
    height: 20px;
    stroke: #e8ab3f;
    stroke-width: 2;
    flex-shrink: 0;
  }

  .float-lang-code {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.5px;
    color: #ffffff;
    text-transform: uppercase;
  }

  .float-lang-chevron {
    width: 14px;
    height: 14px;
    stroke: #e8ab3f;
    stroke-width: 2.5;
    transition: transform 0.3s ease;
  }

  .float-lang-btn[aria-expanded="true"] .float-lang-chevron {
    transform: rotate(180deg);
  }

  /* Clean White / PMGB Brand Popover Card */
  .float-lang-menu {
    position: absolute;
    bottom: 60px;
    right: 0;
    width: 230px;
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-top: 4px solid #e8ab3f;
    border-radius: 14px;
    box-shadow: 0 14px 40px rgba(19, 63, 144, 0.18);
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px) scale(0.96);
    transition: all 0.25s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .float-lang-menu.active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }

  .float-lang-header {
    font-size: 11px;
    font-weight: 800;
    color: #133f90;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 4px 10px 8px;
    margin-bottom: 4px;
    border-bottom: 1px solid #f1f5f9;
  }

  /* Language Option Item */
  .float-lang-option {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 12px;
    border-radius: 8px;
    color: #334155;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    transition: all 0.2s ease;
    cursor: pointer;
    background: transparent;
    border: 1px solid transparent;
    width: 100%;
    text-align: left;
  }

  .float-lang-option:hover,
  .float-lang-option:focus {
    background-color: rgba(19, 63, 144, 0.06);
    color: #133f90;
    outline: none;
  }

  .float-lang-option.active {
    background-color: #133f90;
    color: #ffffff;
    border-color: #133f90;
  }

  .float-lang-label {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .float-lang-flag {
    font-size: 18px;
    line-height: 1;
  }

  .float-lang-check {
    color: #e8ab3f;
    display: none;
    flex-shrink: 0;
  }

  .float-lang-option.active .float-lang-check {
    display: block;
  }

  .float-lang-note {
    font-size: 10.5px;
    color: #64748b;
    padding: 6px 10px 2px;
    text-align: center;
    line-height: 1.35;
  }

  /* Responsive adjust for mobile screen boundaries */
  @media screen and (max-width: 479px) {
    .float-lang-container {
      bottom: 20px;
      right: 20px;
    }
    .float-lang-menu {
      width: 210px;
    }
  }
</style>

<div class="float-lang-container" id="FloatLanguageSelector">
  <!-- Trigger Button -->
  <button 
    class="float-lang-btn" 
    id="FloatLangTrigger" 
    aria-expanded="false" 
    aria-haspopup="true" 
    aria-label="Select language"
    title="Change language"
  >
    <svg class="float-globe-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
    </svg>
    <span class="float-lang-code" id="CurrentLangCode">
      {{ localization.language.iso_code | default: 'EN' }}
    </span>
    <svg class="float-lang-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <!-- Language selection menu -->
  <div class="float-lang-menu" id="FloatLangMenu" role="menu" aria-labelledby="FloatLangTrigger">
    <div class="float-lang-header">Select Language</div>

    {%- comment -%} Determine if we have multiple published languages in Shopify {%- endcomment -%}
    {%- assign real_languages_count = localization.available_languages.size -%}
    
    {%- if real_languages_count > 1 -%}
      {%- comment -%} NATIVE SHOPIFY LOCALIZATION FORM {%- endcomment -%}
      {%- form 'localization', id: 'FloatLanguageForm' -%}
        <input type="hidden" name="locale_code" id="FloatLocaleCode" value="{{ localization.language.iso_code }}">
        
        {%- for language in localization.available_languages -%}
          {%- assign flag = '🌐' -%}
          {%- if language.iso_code == 'en' -%}{%- assign flag = '🇬🇧' -%}
          {%- elsif language.iso_code == 'zh' or language.iso_code == 'zh-CN' -%}{%- assign flag = '🇨🇳' -%}
          {%- elsif language.iso_code == 'zh-TW' -%}{%- assign flag = '🇹🇼' -%}
          {%- elsif language.iso_code == 'ja' -%}{%- assign flag = '🇯🇵' -%}
          {%- elsif language.iso_code == 'ms' -%}{%- assign flag = '🇲🇾' -%}
          {%- elsif language.iso_code == 'id' -%}{%- assign flag = '🇮🇩' -%}
          {%- elsif language.iso_code == 'th' -%}{%- assign flag = '🇹🇭' -%}
          {%- elsif language.iso_code == 'vi' -%}{%- assign flag = '🇻🇳' -%}
          {%- elsif language.iso_code == 'es' -%}{%- assign flag = '🇪🇸' -%}
          {%- elsif language.iso_code == 'de' -%}{%- assign flag = '🇩🇪' -%}
          {%- endif -%}

          <button 
            type="button"
            class="float-lang-option{% if language.iso_code == localization.language.iso_code %} active{% endif %}"
            role="menuitem"
            data-value="{{ language.iso_code }}"
            tabindex="-1"
          >
            <span class="float-lang-label">
              <span class="float-lang-flag">{{ flag }}</span>
              <span>{{ language.endonym_name | capitalize }}</span>
            </span>
            <svg class="float-lang-check" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          </button>
        {%- endfor -%}
      {%- endform -%}

    {%- else -%}
      {%- comment -%} PREMIUM INTERACTIVE FALLBACK (For testing visual switcher in draft status) {%- endcomment -%}
      {%- assign mock_languages = "en:🇺🇸:English,es:🇪🇸:Español,de:🇩🇪:Deutsch" | split: ',' -%}
      {%- assign active_mock = 'en' -%}

      {%- for mock in mock_languages -%}
        {%- assign parts = mock | split: ':' -%}
        {%- assign iso = parts[0] -%}
        {%- assign emoji = parts[1] -%}
        {%- assign name = parts[2] -%}

        <button 
          type="button"
          class="float-lang-option{% if iso == active_mock %} active{% endif %}"
          role="menuitem"
          data-mock-value="{{ iso }}"
          tabindex="-1"
          onclick="selectMockLanguage('{{ iso }}')"
        >
          <span class="float-lang-label">
            <span class="float-lang-flag">{{ emoji }}</span>
            <span>{{ name }}</span>
          </span>
          <svg class="float-lang-check" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
        </button>
      {%- endfor -%}
      <div class="float-lang-note">Publish languages in Settings → Languages to enable native routing paths.</div>
    {%- endif -%}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var trigger = document.getElementById('FloatLangTrigger');
    var menu = document.getElementById('FloatLangMenu');
    var container = document.getElementById('FloatLanguageSelector');
    var options = menu.querySelectorAll('.float-lang-option');
    var currentFocusIndex = -1;

    // Toggle menu visibility
    function toggleMenu(forceClose) {
      var isOpen = menu.classList.contains('active');
      var shouldOpen = forceClose !== undefined ? !forceClose : !isOpen;

      if (shouldOpen) {
        menu.classList.add('active');
        trigger.setAttribute('aria-expanded', 'true');
        currentFocusIndex = 0;
        // Focus first option
        if (options.length > 0) {
          setTimeout(function() { options[0].focus(); }, 50);
        }
      } else {
        if (isOpen) {
          menu.classList.remove('active');
          trigger.setAttribute('aria-expanded', 'false');
          trigger.focus();
          currentFocusIndex = -1;
        }
      }
    }

    trigger.addEventListener('click', function(e) {
      e.stopPropagation();
      toggleMenu();
    });

    // Close on click outside
    document.addEventListener('click', function(e) {
      if (!container.contains(e.target)) {
        toggleMenu(true);
      }
    });

    // Keyboard handlers
    container.addEventListener('keydown', function(e) {
      var isOpen = menu.classList.contains('active');

      if (e.key === 'Escape' || e.key === 'Esc') {
        toggleMenu(true);
        e.preventDefault();
        return;
      }

      if (!isOpen) return;

      // Handle Arrow keys navigation
      if (e.key === 'ArrowDown' || e.key === 'Down') {
        currentFocusIndex = (currentFocusIndex + 1) % options.length;
        options[currentFocusIndex].focus();
        e.preventDefault();
      } else if (e.key === 'ArrowUp' || e.key === 'Up') {
        currentFocusIndex = (currentFocusIndex - 1 + options.length) % options.length;
        options[currentFocusIndex].focus();
        e.preventDefault();
      } else if (e.key === 'Home') {
        currentFocusIndex = 0;
        options[0].focus();
        e.preventDefault();
      } else if (e.key === 'End') {
        currentFocusIndex = options.length - 1;
        options[currentFocusIndex].focus();
        e.preventDefault();
      } else if (e.key === 'Tab') {
        // Focus trap
        if (e.shiftKey) { // Shift + Tab
          if (document.activeElement === options[0]) {
            options[options.length - 1].focus();
            currentFocusIndex = options.length - 1;
            e.preventDefault();
          }
        } else { // Tab
          if (document.activeElement === options[options.length - 1]) {
            options[0].focus();
            currentFocusIndex = 0;
            e.preventDefault();
          }
        }
      }
    });

    // Native Shopify form submit on choice click
    options.forEach(function(opt) {
      if (opt.hasAttribute('data-value')) {
        opt.addEventListener('click', function(e) {
          e.preventDefault();
          var locale = this.getAttribute('data-value');
          var codeInput = document.getElementById('FloatLocaleCode');
          var form = document.getElementById('FloatLanguageForm');
          if (codeInput && form) {
            codeInput.value = locale;
            form.submit();
          }
        });
      }
    });
  });

  // Mock Selector for visually previewing selection
  function selectMockLanguage(iso) {
    var menu = document.getElementById('FloatLangMenu');
    var triggerCode = document.getElementById('CurrentLangCode');
    
    // Toggle active classes
    var options = menu.querySelectorAll('[data-mock-value]');
    options.forEach(function(opt) {
      if (opt.getAttribute('data-mock-value') === iso) {
        opt.classList.add('active');
      } else {
        opt.classList.remove('active');
      }
    });

    // Update floating button code display
    if (triggerCode) {
      triggerCode.textContent = iso.toUpperCase();
    }

    // Close menu
    setTimeout(function() {
      menu.classList.remove('active');
      document.getElementById('FloatLangTrigger').setAttribute('aria-expanded', 'false');
      document.getElementById('FloatLangTrigger').focus();
    }, 250);
  }
</script>
{%- endcomment -%}