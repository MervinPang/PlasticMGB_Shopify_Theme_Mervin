{%- comment -%}
  Redesigned Main Cart Section — repurposed as a B2B Request for Quote (RFQ) List.
  Removes price checkout and embeds the RFQ Form directly.
{%- endcomment -%}

<style>
  .rfq-section {
    padding: 140px 20px 80px;
    background-color: #fff;
    color: #fff;
    font-family: 'Exo', sans-serif;
    overflow: hidden;
  }

  .rfq-container {
    max-width: 1000px;
    margin: 0 auto;
    width: 100%;
    box-sizing: border-box;
  }

  .rfq-title {
    font-size: 32px;
    color: #133f90;
    margin-bottom: 30px;
    font-weight: 800;
    border-bottom: 2px solid #133f90;
    padding-bottom: 15px;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .rfq-empty-message {
    text-align: center;
    padding: 80px 20px;
  }

  .rfq-empty-text {
    font-size: 18px;
    color: #64748b;
    margin-bottom: 25px;
  }

  .rfq-button-primary {
    background-color: #133f90;
    color: #fff !important;
    padding: 12px 30px;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 14px;
    display: inline-block;
    transition: all 0.3s ease;
    box-shadow: 0 4px 10px rgba(19, 63, 144, 0.2);
  }

  .rfq-button-primary:hover {
    background-color: #133f90;
    box-shadow: 0 4px 10px #133f901c;
  }

  /* Success Card */
  .rfq-success-card {
    background-color: #f0fdf4;
    border: 2px solid #bbf7d0;
    border-radius: 12px;
    padding: 30px;
    text-align: center;
    margin-bottom: 40px;
    box-shadow: 0 4px 15px rgba(22, 163, 74, 0.05);
  }

  .rfq-success-title {
    color: #16a34a;
    font-size: 22px;
    font-weight: 700;
    margin-bottom: 10px;
    overflow-wrap: break-word;
  }

  .rfq-success-text {
    color: #15803d;
    font-size: 15px;
    margin-bottom: 20px;
  }

  /* Table styling */
  .rfq-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 40px;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    overflow: hidden;
  }

  .rfq-table th {
    background-color: #133f90;
    color: #fff;
    font-weight: 700;
    padding: 14px 20px;
    text-align: left;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .rfq-table td {
    padding: 20px;
    border-bottom: 1px solid #e2e8f0;
    vertical-align: middle;
  }

  .rfq-table tr:last-child td {
    border-bottom: none;
  }

  .rfq-table tr:nth-child(even) {
    background-color: #f8fafc;
  }

  .rfq-item-product {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .rfq-item-image {
    width: 80px;
    height: 80px;
    object-fit: contain;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    background: #fff;
    padding: 4px;
    flex-shrink: 0;
  }

  .rfq-item-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .rfq-item-title {
    font-weight: 700;
    color: #133f90;
    text-decoration: none;
    font-size: 16px;
    transition: color 0.2s ease;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .rfq-item-title:hover {
    color: #133f90;
  }

  .rfq-item-variant {
    font-size: 13px;
    color: #64748b;
  }

  .rfq-qty-input {
    width: 80px;
    padding: 8px 12px;
    border: 2px solid #e2e8f0;
    border-radius: 6px;
    text-align: center;
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
  }

  .rfq-qty-input:focus {
    border-color: #133f90;
    outline: none;
  }

  .rfq-remove-btn {
    color: #94a3b8;
    text-decoration: none;
    font-size: 20px;
    font-weight: 700;
    transition: color 0.2s ease;
    display: inline-block;
    padding: 5px;
  }

  .rfq-remove-btn:hover {
    color: #ef4444;
  }

  /* Form section */
  .rfq-form-card {
    background-color: #fff;
    color: #fff;
    border-radius: 16px;
    padding: 40px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.15);
    background-image: linear-gradient(135deg, #fff 0%, #133f901c 100%);
    box-sizing: border-box;
  }

  .rfq-form-header {
    margin-bottom: 30px;
    border-left: 4px solid #133f90;
    padding-left: 15px;
  }

  .rfq-form-title {
    font-size: 22px;
    font-weight: 800;
    color: #133f90;
    margin: 0 0 5px;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .rfq-form-subtitle {
    font-size: 14px;
    color: #94a3b8;
    margin: 0;
  }

  .rfq-form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 25px;
  }

  .rfq-form-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .rfq-form-field.full-width {
    grid-column: 1 / -1;
  }

  .rfq-label {
    font-size: 13px;
    font-weight: 700;
    color: #133f90;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .rfq-input {
    width: 100%;
    padding: 12px 16px;
    background-color: #4c5b761c;
    border: 1px solid #3f424d;
    border-radius: 8px;
    color: #333;
    font-family: inherit;
    font-size: 15px;
    transition: all 0.3s ease;
    box-sizing: border-box;
  }

  .rfq-input:focus {
    border-color: #133f90;
    outline: none;
    background-color: #fff;
    box-shadow: 0 0 0 3px #133f901c;
  }

  .rfq-textarea {
    resize: vertical;
    min-height: 120px;
  }

  .rfq-submit-btn {
    background-color: #133f90;
    color: #ffffffff;
    border: none;
    padding: 14px 35px;
    border-radius: 50px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 10px;
    justify-content: center;
    box-shadow: 0 4px 15px #133f901c;
  }

  .rfq-submit-btn:hover {
    background-color: #fff;
    color: #133f90;
    box-shadow: 0 4px 15px rgba(255, 255, 255, 0.2);
  }

  .rfq-submit-btn svg {
    transition: transform 0.3s ease;
  }

  .rfq-submit-btn:hover svg {
    transform: translateX(4px);
  }

  @media screen and (max-width: 767px) {
    .rfq-section {
      padding: 90px 14px 40px !important;
      overflow: hidden !important;
    }

    .rfq-title {
      font-size: 24px !important;
      margin-bottom: 20px !important;
      padding-bottom: 10px !important;
    }

    .rfq-table {
      display: block !important;
      width: 100% !important;
      border: none !important;
      background: transparent !important;
      margin-bottom: 24px !important;
    }

    .rfq-table thead {
      display: none !important;
    }

    .rfq-table tbody {
      display: flex !important;
      flex-direction: column !important;
      gap: 12px !important;
      width: 100% !important;
    }

    .rfq-table tr {
      display: flex !important;
      flex-direction: column !important;
      width: 100% !important;
      background: #f8fafc !important;
      border: 1px solid #e2e8f0 !important;
      border-radius: 12px !important;
      padding: 14px !important;
      box-sizing: border-box !important;
      position: relative !important;
      gap: 10px !important;
    }

    .rfq-table td {
      display: block !important;
      padding: 0 !important;
      border-bottom: none !important;
      width: 100% !important;
      box-sizing: border-box !important;
    }

    .rfq-table td:nth-child(2) {
      position: absolute !important;
      top: 10px !important;
      right: 12px !important;
      width: auto !important;
      padding: 0 !important;
      border-top: none !important;
    }

    .rfq-item-product {
      gap: 12px !important;
      align-items: center !important;
      padding-right: 32px !important;
    }

    .rfq-item-image {
      width: 60px !important;
      height: 60px !important;
      flex-shrink: 0 !important;
    }

    .rfq-item-title {
      font-size: 15px !important;
      line-height: 1.35 !important;
    }

    .rfq-form-card {
      padding: 22px 16px !important;
      border-radius: 14px !important;
      box-sizing: border-box !important;
    }

    .rfq-form-header {
      margin-bottom: 20px !important;
      padding-left: 12px !important;
    }

    .rfq-form-title {
      font-size: 19px !important;
    }

    .rfq-form-subtitle {
      font-size: 13px !important;
      line-height: 1.4 !important;
    }

    .rfq-form-grid {
      grid-template-columns: 1fr !important;
      gap: 14px !important;
      margin-bottom: 20px !important;
    }

    .rfq-input {
      font-size: 14px !important;
      padding: 10px 14px !important;
    }

    .rfq-submit-btn {
      width: 100% !important;
      padding: 14px 20px !important;
      font-size: 14px !important;
    }
  }
</style>

<section class="rfq-section">
  <div class="rfq-container">
    {%- if content_for_header contains 'quote_submitted=true' or canonical_url contains 'quote_submitted=true' -%}
      <div class="rfq-success-card">
        <h2 class="rfq-success-title">{{ 'cart.rfq.success_title' | t }}</h2>
        <p class="rfq-success-text">{{ 'cart.rfq.success_message' | t }}</p>
        <a href="{{ routes.root_url }}" class="rfq-button-primary">{{ 'cart.rfq.return_to_homepage' | t }}</a>
      </div>
    {%- endif -%}

    <h1 class="rfq-title">{{ 'cart.rfq.title' | t }}</h1>

    {%- if cart.item_count == 0 -%}
      {%- unless canonical_url contains 'quote_submitted=true' -%}
        <div class="rfq-empty-message">
          <p class="rfq-empty-text">{{ 'cart.rfq.empty_message' | t }}</p>
          <a href="{{ routes.all_products_collection_url | default: routes.root_url }}" class="rfq-button-primary">{{ 'cart.rfq.browse_products' | t }}</a>
        </div>
      {%- endunless -%}
    {%- else -%}
      <form action="{{ routes.cart_update_url }}" method="post" id="rfq-cart-form">
        <table class="rfq-table">
          <thead>
            <tr>
              <th>{{ 'cart.rfq.table_product' | t }}</th>
              <th style="text-align: center; width: 60px;">{{ 'cart.rfq.table_remove' | t }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for item in cart.items -%}
              <tr data-line="{{ forloop.index }}">
                <td>
                  <div class="rfq-item-product">
                    <a href="{{ item.url }}">
                      {%- if item.image -%}
                        <img src="{{ item.image | image_url: width: 150 }}" alt="{{ item.image.alt | escape }}" class="rfq-item-image">
                      {%- else -%}
                        {{ 'product-1' | placeholder_svg_tag: 'rfq-item-image' }}
                      {%- endif -%}
                    </a>
                    <div class="rfq-item-info">
                      <a href="{{ item.url }}" class="rfq-item-title">{{ item.product.title }}</a>
                      {%- unless item.product.has_only_default_variant -%}
                        <span class="rfq-item-variant">{{ item.variant.title }}</span>
                      {%- endunless -%}
                    </div>
                  </div>
                </td>
                <td style="text-align: center;">
                  <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" class="rfq-remove-btn cart-remove-link" aria-label="{{ 'cart.general.remove' | t }} {{ item.product.title | escape }}">&times;</a>
                </td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </form>

      {%- comment -%} RFQ Contact Form integration {%- endcomment -%}
      <div class="rfq-form-card">
        <div class="rfq-form-header">
          <h2 class="rfq-form-title">{{ 'cart.rfq.form_title' | t }}</h2>
          <p class="rfq-form-subtitle">{{ 'cart.rfq.form_subtitle' | t }}</p>
        </div>

        {%- form 'contact' -%}
          {%- if form.posted_successfully? -%}
            <script>
              /* Clear the cart natively via AJAX upon successful submit */
              fetch('/cart/clear.js', { method: 'POST' })
                .then(function() {
                  window.location.href = window.location.pathname + '?quote_submitted=true';
                });
            </script>
          {%- endif -%}

          {{ form.errors | default_errors }}

          {%- comment -%} Hidden compiled list of cart items {%- endcomment -%}
          {%- capture quote_list_payload -%}
            {%- for item in cart.items -%}
              {{ item.product.title }} {% unless item.product.has_only_default_variant %}({{ item.variant.title }}){% endunless %}
              {%- unless forloop.last -%} | {%- endunless -%}
            {%- endfor -%}
          {%- endcapture -%}
          <input type="hidden" name="contact[quote_list]" value="{{ quote_list_payload | escape }}">
          <input type="hidden" name="contact[page_origin]" value="RFQ Page">

          <div class="rfq-form-grid">
            <div class="rfq-form-field">
              <label class="rfq-label" for="rfq-company">{{ 'cart.rfq.company_name' | t }}</label>
              <input type="text" id="rfq-company" name="contact[company_name]" required class="rfq-input" placeholder="e.g. Plastic MGB Logistics">
            </div>

            <div class="rfq-form-field">
              <label class="rfq-label" for="rfq-name">{{ 'cart.rfq.contact_person' | t }}</label>
              <input type="text" id="rfq-name" name="contact[name]" required class="rfq-input" placeholder="e.g. John Doe">
            </div>

            <div class="rfq-form-field">
              <label class="rfq-label" for="rfq-email">{{ 'cart.rfq.business_email' | t }}</label>
              <input type="email" id="rfq-email" name="contact[email]" required class="rfq-input" placeholder="e.g. procurement@company.com">
            </div>

            <div class="rfq-form-field">
              <label class="rfq-label" for="rfq-phone">{{ 'cart.rfq.business_telephone' | t }}</label>
              <input type="tel" id="rfq-phone" name="contact[phone]" required class="rfq-input" placeholder="e.g. +86 1XX XXXX XXXX">
            </div>

            <div class="rfq-form-field full-width">
              <label class="rfq-label" for="rfq-message">{{ 'cart.rfq.additional_requirements' | t }}</label>
              <textarea id="rfq-message" name="contact[body]" class="rfq-input rfq-textarea" placeholder="Describe any custom labeling, delivery deadlines, or target order sizes..."></textarea>
            </div>
          </div>

          <div style="display: flex; justify-content: flex-end;">
            <button type="submit" class="rfq-submit-btn">
              {{ 'cart.rfq.submit' | t }}
              <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </button>
          </div>
        {%- endform -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Main Cart",
  "tag": "section",
  "settings": [],
  "presets": [
    {
      "name": "Main Cart"
    }
  ]
}
{% endschema %}
