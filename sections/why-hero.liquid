{%- if section.settings.background_image != blank -%}
  {%- assign bg_image_url = section.settings.background_image | image_url: width: 2000 -%}
{%- else -%}
  {%- assign bg_image_url = 'Wheels_on_blueprint_CAD_files_202605281042-transformed.jpeg' | asset_url -%}
{%- endif -%}

<section class="hero-why-choose-us" style="background-image: url('{{ bg_image_url }}');">
  <div class="hero-wrapper">
    <div class="hero-background">
      <div class="hero-card">
        {%- assign eyebrow = section.settings.eyebrow -%}
        {%- if eyebrow == blank or eyebrow == 'WHY CHOOSE US' -%}
          {%- assign eyebrow = 'sections.why_hero.eyebrow' | t -%}
        {%- endif -%}
        {%- assign heading = section.settings.heading -%}
        {%- if heading == blank or heading == 'Plastic MGB Made To Perform' -%}
          {%- assign heading = 'sections.why_hero.heading' | t -%}
        {%- endif -%}
        {%- assign description = section.settings.description -%}
        {%- assign default_desc = 'Accessories for Mobile Waste Container are the heart of our business. Our quality products are tough, resilient and made to perform throughout its life cycle. Our products are made to perform and excel in safety, enabling you to maximise productivity of your bin fleet and generate savings that are far more superior to other manufacturers, delivering high performance products that last.' -%}
        {%- if description == blank or description == default_desc -%}
          {%- assign description = 'sections.why_hero.description' | t -%}
        {%- endif -%}

        <div class="eyebrow">
          <svg width="100%" height="100%" fill="none" xmlns="http://www.w3.org/2000/svg" viewbox="0 0 16 16" class="svg-2">
            <path fill-rule="evenodd" d="M2 8a.5.5 0 0 1 .5-.5h11a.5.5 0 0 1 0 1h-11A.5.5 0 0 1 2 8Z" fill="currentColor" class="path"></path>
          </svg>
          <h1 class="heading-6">{{ eyebrow }}</h1>
        </div>
        <div class="div-block-16">
          <h1 class="heading-7"><strong class="bold-text-2">{{ heading }}</strong></h1>
          <div class="text-block-8-copy">{{ description }}</div>
        </div>
      </div>
      <div class="hero-contact-us">
        <div>
          <h1 class="heading-10">{{ 'contact.form.heading' | t }}</h1>
        </div>
        <div class="w-form">
          {% form 'contact' %}
            <div class="form">
              <label for="Company-Name" class="field-label-2">{{ 'contact.form.company_name' | t }}</label>
              <input class="w-input" maxlength="256" name="contact[company_name]" placeholder="{{ 'contact.form.placeholder_company' | t }}" type="text" id="Company-Name" required="">
              <label for="name" class="field-label-2">{{ 'contact.form.name' | t }}</label>
              <input class="w-input" maxlength="256" name="contact[name]" placeholder="{{ 'contact.form.placeholder_name' | t }}" type="text" id="name" required="">
              <label for="email" class="field-label">{{ 'contact.form.email' | t }}</label>
              <input class="w-input" maxlength="256" name="contact[email]" placeholder="{{ 'contact.form.placeholder_email' | t }}" type="email" id="email" required="">
              <label for="Text" class="field-label">{{ 'contact.form.telephone' | t }}</label>
              <input class="w-input" maxlength="256" name="contact[phone]" placeholder="{{ 'contact.form.placeholder_telephone' | t }}" type="tel" id="Text" required="">
              <label for="Message" class="field-label-2">{{ 'contact.form.message' | t }}</label>
              <textarea required="" placeholder="{{ 'contact.form.placeholder_message' | t }}" maxlength="5000" id="Message" name="contact[body]" class="textarea w-input"></textarea>
              <input type="submit" data-wait="{{ 'contact.form.please_wait' | t }}" class="submit-button w-button" value="{{ 'contact.form.submit' | t }}">
            </div>
          {% endform %}
          {% if form.posted_successfully? %}
            <div class="w-form-done" style="display:block;">
              <div>{{ 'contact.form.success' | t }}</div>
            </div>
          {% endif %}
          {% if form.errors %}
            <div class="w-form-fail" style="display:block;">
              <div>{{ 'contact.form.error' | t }}</div>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Why Choose Us Hero",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "WHY CHOOSE US"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Plastic MGB Made To Perform"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    }
  ],
  "presets": [
    {
      "name": "Why Choose Us Hero"
    }
  ]
}
{% endschema %}
