<style>
  /* Hero space for background video showcase before credential cards appear */
  .section-9 {
    height: 330vh !important;
  }

  .credential-wrapper {
    margin-top: 85vh !important;
    height: 230vh !important;
  }

  @media screen and (max-width: 991px) {
    .section-9 {
      height: 420vh !important;
    }
    .credential-wrapper {
      margin-top: 70vh !important;
      height: auto !important;
    }
  }

  @media screen and (max-width: 640px) {
    .section-9 {
      height: 460vh !important;
    }
    .credential-wrapper {
      margin-top: 60vh !important;
      height: auto !important;
    }
  }
</style>

<section class="section-9">
  <div class="video-bg">
    <div class="code-embed-3 w-embed">
      <video id="scrollVideo" src="{{ section.settings.video_url | default: 'https://s3.amazonaws.com/webflow-prod-assets/6a0e5b9b1175cebdbb2d04ba/6a266eee65f2eec5a9e33100_1.mp4' }}" muted playsinline preload="auto" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover;">
      </video>
    </div>
  </div>
  <div class="certification-section">
    <div class="credential-wrapper">
      <div class="div-block-14">
        {%- assign eyebrow = section.settings.eyebrow -%}
        {%- if eyebrow == blank or eyebrow == 'OUR CREDENTIALS' -%}
          {%- assign eyebrow = 'sections.credentials.eyebrow' | t -%}
        {%- endif -%}
        {%- assign heading = section.settings.heading -%}
        {%- if heading == blank or heading == 'Quality and Compliance You Can Rely On' -%}
          {%- assign heading = 'sections.credentials.heading' | t -%}
        {%- endif -%}
        {%- assign description = section.settings.description -%}
        {%- assign default_desc = 'Every product in our range is manufactured to meet the compliance requirements of global OEM procurement teams. Certification documentation is available to verified buyers upon request.' -%}
        {%- if description == blank or description == default_desc -%}
          {%- assign description = 'sections.credentials.description' | t -%}
        {%- endif -%}

        <div class="eyebrow">
          <svg width="100%" height="100%" fill="none" xmlns="http://www.w3.org/2000/svg" viewbox="0 0 16 16" class="svg-2">
            <path fill-rule="evenodd" d="M2 8a.5.5 0 0 1 .5-.5h11a.5.5 0 0 1 0 1h-11A.5.5 0 0 1 2 8Z" fill="currentColor" class="path"></path>
          </svg>
          <h1 class="heading-6">{{ eyebrow }}</h1>
        </div>
        <div class="div-block-16">
          <h1 class="heading-7"><strong class="bold-text-2">{{ heading }}</strong></h1>
          <div class="text-block-8-copy">{{ description }}</div>
        </div>
      </div>
      <div class="certification-wrapper">
        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            {% if block.type == 'primary_card' %}
              <!-- Primary Card -->
              <div class="primary-card" {{ block.shopify_attributes }}>
                <div class="primary">
                  <svg width="100%" height="100%" fill="none" xmlns="http://www.w3.org/2000/svg" viewbox="0 0 16 16" class="svg-2">
                    <path fill-rule="evenodd" d="M2 8a.5.5 0 0 1 .5-.5h11a.5.5 0 0 1 0 1h-11A.5.5 0 0 1 2 8Z" fill="currentColor" class="path"></path>
                  </svg>
                  <h1 class="heading-6">{{ block.settings.eyebrow }}</h1>
                </div>
                <div class="div-block-21">
                  <h1 class="heading-8"><strong class="bold-text-3">{{ block.settings.title }}</strong></h1>
                  <svg width="100%" height="100%" fill="none" xmlns="http://www.w3.org/2000/svg" viewbox="0 0 25 25" class="badge">
                    <path d="M16.7143 9.14771L11.5209 15.1473L9.21484 12.888" stroke="currentColor" stroke-width="1.49989" stroke-linecap="round" stroke-linejoin="round" fill="transparent"></path>
                    <path d="M22.6711 6.16531C18.4799 5.41349 16.7471 4.85666 12.9641 3.14819C9.18107 4.85666 7.44823 5.41349 3.25699 6.16531C2.49767 18.2 12.2413 22.3557 12.9641 22.6467C13.6868 22.3557 23.4305 18.2 22.6711 6.16531Z" stroke="currentColor" stroke-width="1.49989" stroke-linecap="round" stroke-linejoin="round" fill="transparent"></path>
                  </svg>
                </div>
                <div class="text-block-8">{{ block.settings.description }}</div>
                <a href="{{ pages['contact-us'].url | default: '/pages/contact-us' }}" class="redirect">{{ 'sections.credentials.request_documentation' | t }}</a>
              </div>
            {% elsif block.type == 'credential_card' %}
              <!-- Credential Card -->
              <div class="credential-card" {{ block.shopify_attributes }}>
                <div class="div-block-21">
                  <h1 class="heading-8"><strong class="bold-text-3">{{ block.settings.title }}</strong></h1>
                  {% if block.settings.icon == 'leaf' %}
                    <svg width="100%" height="100%" fill="none" xmlns="http://www.w3.org/2000/svg" viewbox="0 0 24 25" class="badge">
                      <path d="M15.0753 8.96984C10.9089 6.27848 6.59676 8.21052 2.61269 3.99209C1.68463 3.00779 2.22366 15.0303 7.21078 19.5862C10.8569 22.9141 16.4866 22.5429 18.3849 19.3087C20.2832 16.0746 19.2417 11.6607 15.0753 8.96984Z" stroke="currentColor" stroke-width="1.49989" stroke-linecap="round" stroke-linejoin="round" fill="transparent"></path>
                      <path d="M8.09961 12.7939C12.1306 16.5905 16.3021 18.8404 21.7861 19.6841" stroke="currentColor" stroke-width="1.49989" stroke-linecap="round" stroke-linejoin="round" fill="transparent"></path>
                    </svg>
                  {% elsif block.settings.icon == 'checkmark' %}
                    <svg width="100%" height="100%" fill="none" xmlns="http://www.w3.org/2000/svg" viewbox="0 0 24 25" class="badge">
                      <path d="M19.4891 6.97107L8.98989 18.9702L4.49023 14.4705" stroke="currentColor" stroke-width="1.49989" stroke-linecap="round" stroke-linejoin="round" fill="transparent"></path>
                    </svg>
                  {% elsif block.settings.icon == 'droplet' %}
                    <svg width="100%" height="100%" fill="none" xmlns="http://www.w3.org/2000/svg" viewbox="0 0 25 25" class="badge">
                      <path d="M19.7334 15.8786C19.7334 20.0206 17.1259 22.6281 12.9839 22.6281C8.84183 22.6281 6.23438 20.0206 6.23438 15.8786C6.23438 11.4337 11.0729 5.43326 12.5569 3.69761C12.6097 3.63594 12.6752 3.58644 12.7489 3.55249C12.8227 3.51855 12.9029 3.50098 12.9841 3.50098C13.0653 3.50098 13.1455 3.51855 13.2193 3.55249C13.293 3.58644 13.3585 3.63594 13.4113 3.69761C14.8948 5.43326 19.7334 11.4337 19.7334 15.8786Z" stroke="currentColor" stroke-width="1.49989" stroke-miterlimit="10" fill="transparent"></path>
                      <path d="M17.1052 16.2534C17.1052 17.1485 16.7497 18.0068 16.1168 18.6397C15.4839 19.2726 14.6255 19.6282 13.7305 19.6282" stroke="currentColor" stroke-width="1.49989" stroke-linecap="round" stroke-linejoin="round" fill="transparent"></path>
                    </svg>
                  {% endif %}
                </div>
                <div class="text-block-8">{{ block.settings.description }}</div>
                <a href="{{ pages['contact-us'].url | default: '/pages/contact-us' }}" class="redirect">{{ 'sections.credentials.request_documentation' | t }}</a>
              </div>
            {% endif %}
          {% endfor %}
        {% else %}
          <!-- Default Fallback Primary Card -->
          <div class="primary-card">
            <div class="primary">
              <svg width="100%" height="100%" fill="none" xmlns="http://www.w3.org/2000/svg" viewbox="0 0 16 16" class="svg-2">
                <path fill-rule="evenodd" d="M2 8a.5.5 0 0 1 .5-.5h11a.5.5 0 0 1 0 1h-11A.5.5 0 0 1 2 8Z" fill="currentColor" class="path"></path>
              </svg>
              <h1 class="heading-6">PRIMARY CERTIFICATION</h1>
            </div>
            <div class="div-block-21">
              <h1 class="heading-8"><strong class="bold-text-3">EN840 / SKZ certified</strong></h1>
              <svg width="100%" height="100%" fill="none" xmlns="http://www.w3.org/2000/svg" viewbox="0 0 25 25" class="badge">
                <path d="M16.7143 9.14771L11.5209 15.1473L9.21484 12.888" stroke="currentColor" stroke-width="1.49989" stroke-linecap="round" stroke-linejoin="round" fill="transparent"></path>
                <path d="M22.6711 6.16531C18.4799 5.41349 16.7471 4.85666 12.9641 3.14819C9.18107 4.85666 7.44823 5.41349 3.25699 6.16531C2.49767 18.2 12.2413 22.3557 12.9641 22.6467C13.6868 22.3557 23.4305 18.2 22.6711 6.16531Z" stroke="currentColor" stroke-width="1.49989" stroke-linecap="round" stroke-linejoin="round" fill="transparent"></path>
              </svg>
            </div>
            <div class="text-block-8">EN840 is the European standard that regulates the design, performance, and testing of mobile waste receptacles. Our EN840 certification is granted and independently verified by the SKZ Institute.</div>
            <a href="{{ pages['contact-us'].url | default: '/pages/contact-us' }}" class="redirect">{{ 'sections.credentials.request_documentation' | t }}</a>
          </div>
          <!-- Default Fallback Credential Card 1 -->
          <div class="credential-card">
            <div class="div-block-21">
              <h1 class="heading-8"><strong class="bold-text-3">REACH (EC) – 155 SVHC</strong></h1>
              <svg width="100%" height="100%" fill="none" xmlns="http://www.w3.org/2000/svg" viewbox="0 0 24 25" class="badge">
                <path d="M15.0753 8.96984C10.9089 6.27848 6.59676 8.21052 2.61269 3.99209C1.68463 3.00779 2.22366 15.0303 7.21078 19.5862C10.8569 22.9141 16.4866 22.5429 18.3849 19.3087C20.2832 16.0746 19.2417 11.6607 15.0753 8.96984Z" stroke="currentColor" stroke-width="1.49989" stroke-linecap="round" stroke-linejoin="round" fill="transparent"></path>
                <path d="M8.09961 12.7939C12.1306 16.5905 16.3021 18.8404 21.7861 19.6841" stroke="currentColor" stroke-width="1.49989" stroke-linecap="round" stroke-linejoin="round" fill="transparent"></path>
              </svg>
            </div>
            <div class="text-block-8">Declaration of conformity covering 155 substances of very high concern. All applicable materials meet REACH requirements for safe handling and use.</div>
            <a href="{{ pages['contact-us'].url | default: '/pages/contact-us' }}" class="redirect">{{ 'sections.credentials.request_documentation' | t }}</a>
          </div>
          <!-- Default Fallback Credential Card 2 -->
          <div class="credential-card">
            <div class="div-block-21">
              <h1 class="heading-8"><strong class="bold-text-3">RoHS</strong></h1>
              <svg width="100%" height="100%" fill="none" xmlns="http://www.w3.org/2000/svg" viewbox="0 0 24 25" class="badge">
                <path d="M19.4891 6.97107L8.98989 18.9702L4.49023 14.4705" stroke="currentColor" stroke-width="1.49989" stroke-linecap="round" stroke-linejoin="round" fill="transparent"></path>
              </svg>
            </div>
            <div class="text-block-8">Restriction of hazardous substances — Cadmium, Lead, Mercury and Hexavalent Chromium compliant across all applicable product lines.</div>
            <a href="{{ pages['contact-us'].url | default: '/pages/contact-us' }}" class="redirect">{{ 'sections.credentials.request_documentation' | t }}</a>
          </div>
          <!-- Default Fallback Credential Card 3 -->
          <div class="credential-card">
            <div class="div-block-21">
              <h1 class="heading-8"><strong class="bold-text-3">Neutral Salt Spray Test</strong></h1>
              <svg width="100%" height="100%" fill="none" xmlns="http://www.w3.org/2000/svg" viewbox="0 0 25 25" class="badge">
                <path d="M19.7334 15.8786C19.7334 20.0206 17.1259 22.6281 12.9839 22.6281C8.84183 22.6281 6.23438 20.0206 6.23438 15.8786C6.23438 11.4337 11.0729 5.43326 12.5569 3.69761C12.6097 3.63594 12.6752 3.58644 12.7489 3.55249C12.8227 3.51855 12.9029 3.50098 12.9841 3.50098C13.0653 3.50098 13.1455 3.51855 13.2193 3.55249C13.293 3.58644 13.3585 3.63594 13.4113 3.69761C14.8948 5.43326 19.7334 11.4337 19.7334 15.8786Z" stroke="currentColor" stroke-width="1.49989" stroke-miterlimit="10" fill="transparent"></path>
                <path d="M17.1052 16.2534C17.1052 17.1485 16.7497 18.0068 16.1168 18.6397C15.4839 19.2726 14.6255 19.6282 13.7305 19.6282" stroke="currentColor" stroke-width="1.49989" stroke-linecap="round" stroke-linejoin="round" fill="transparent"></path>
              </svg>
            </div>
            <div class="text-block-8">Corrosion resistance testing on zinc-plated fork components and steel hardware. Confirms coating durability under sustained salt spray exposure.</div>
            <a href="{{ pages['contact-us'].url | default: '/pages/contact-us' }}" class="redirect">{{ 'sections.credentials.request_documentation' | t }}</a>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const video = document.getElementById("scrollVideo");
    if (!video) return;
    const section = video.closest("section");
    if (!section) return;

    let targetTime = 0;
    let currentTime = 0;
    const ease = 0.08;

    function updateTargetTime() {
      if (!video.duration || isNaN(video.duration) || !isFinite(video.duration)) return;
      const rect = section.getBoundingClientRect();
      const sectionHeight = section.offsetHeight - window.innerHeight;
      if (sectionHeight <= 0) return;
      const scrolled = Math.max(0, -rect.top);
      const scrollPercent = Math.min(1, Math.max(0, scrolled / sectionHeight));
      targetTime = scrollPercent * video.duration;
    }

    window.addEventListener("scroll", updateTargetTime, { passive: true });
    window.addEventListener("resize", updateTargetTime, { passive: true });

    function animate() {
      if (video.duration && !isNaN(video.duration) && isFinite(video.duration)) {
        currentTime += (targetTime - currentTime) * ease;
        if (Math.abs(targetTime - currentTime) > 0.001) {
          video.currentTime = currentTime;
        }
      }
      requestAnimationFrame(animate);
    }

    function initVideoScroll() {
      updateTargetTime();
      animate();
    }

    if (video.readyState >= 1) {
      initVideoScroll();
    } else {
      video.addEventListener("loadedmetadata", initVideoScroll, { once: true });
    }
  });
</script>

