<div class="utility-page-wrap">
  <div class="utility-page-content">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300" width="400" height="300" style="max-width:100%;height:auto;">
      <rect width="400" height="300" fill="#f5f5f5" rx="8"/>
      <text x="200" y="130" text-anchor="middle" font-family="Exo, sans-serif" font-size="72" font-weight="700" fill="#133f90">404</text>
      <text x="200" y="180" text-anchor="middle" font-family="Exo, sans-serif" font-size="16" fill="#666">{{ 'general.page_not_found' | t }}</text>
    </svg>
    <h2>{{ 'general.page_not_found' | t }}</h2>
    <div>{{ 'general.page_not_found_message' | t }}</div>
    <a href="{{ routes.root_url }}" class="button w-button" style="margin-top: 2rem;">{{ 'general.back_to_home' | t }}</a>
  </div>
</div>

{% schema %}
{
  "name": "404 Page",
  "tag": "section",
  "settings": [],
  "presets": [
    {
      "name": "404 Page"
    }
  ]
}
{% endschema %}
