<script>
  (function() {
    var wrapper = document.getElementById('product-marquee-{{ section.id }}');
    if (!wrapper) return;

    /* Clone all original cards to create the duplicate set */
    var originals = wrapper.querySelectorAll('[data-marquee-set="1"]');
    originals.forEach(function(card) {
      var clone = card.cloneNode(true);
      clone.setAttribute('data-marquee-set', '2');
      clone.setAttribute('aria-hidden', 'true');
      clone.setAttribute('tabindex', '-1');
      /* Clear alt text on cloned images to avoid duplicate screen reader content */
      var imgs = clone.querySelectorAll('img');
      imgs.forEach(function(img) { img.alt = ''; });
      wrapper.appendChild(clone);
    });

    function initMarquee() {
      /* Measure the width of the original set (first cards + their margins) */
      var setWidth = 0;
      originals.forEach(function(card) {
        var style = window.getComputedStyle(card);
        setWidth += card.offsetWidth + parseFloat(style.marginRight) + parseFloat(style.marginLeft);
      });

      /* Inject a dynamic keyframe animation with the exact pixel offset */
      var styleTag = document.getElementById('marquee-style-{{ section.id }}');
      if (styleTag) styleTag.remove();

      styleTag = document.createElement('style');
      styleTag.id = 'marquee-style-{{ section.id }}';
      styleTag.textContent =
        '@keyframes marquee-scroll-{{ section.id }} {' +
        '  0% { transform: translate3d(0, 0, 0); }' +
        '  100% { transform: translate3d(-' + setWidth + 'px, 0, 0); }' +
        '}';
      document.head.appendChild(styleTag);

      /* Speed: ~60px per second → total duration adapts to content width */
      var speed = 60;
      var duration = setWidth / speed;
      wrapper.style.animation = 'marquee-scroll-{{ section.id }} ' + duration + 's linear infinite';
    }

    /* Wait for all images to load before measuring */
    var images = wrapper.querySelectorAll('img');
    var loaded = 0;
    var total = images.length;

    function onImageReady() {
      loaded++;
      if (loaded >= total) initMarquee();
    }

    images.forEach(function(img) {
      if (img.complete) {
        onImageReady();
      } else {
        img.addEventListener('load', onImageReady);
        img.addEventListener('error', onImageReady);
      }
    });

    /* Fallback: if images somehow never fire events */
    setTimeout(initMarquee, 3000);

    /* Recalculate on resize */
    var resizeTimer;
    window.addEventListener('resize', function() {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(initMarquee, 200);
    });
  })();
</script>

