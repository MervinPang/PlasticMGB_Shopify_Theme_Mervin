<style>
  .infinite-scroll {
    overflow: hidden !important;
    width: 100% !important;
    max-width: 100% !important;
    box-sizing: border-box !important;
    position: relative !important;
    background-color: var(--radiant-ui-components-library-marketplace--color--pmgb-yellow) !important;
  }
  
  .infinite-scroll .product-wrapper {
    display: flex !important;
    flex-direction: row !important;
    width: max-content !important;
    will-change: transform;
  }
  
  .infinite-scroll .product-wrapper:hover {
    animation-play-state: paused !important;
  }

  .infinite-scroll .scroll-card {
    flex-shrink: 0 !important;
    width: calc(25vw - 16px) !important;
    height: auto !important;
    box-sizing: border-box !important;
    margin-right: 16px !important;
    text-decoration: none !important;
    cursor: pointer !important;
    transition: transform 0.3s ease, opacity 0.3s ease !important;
  }

  .infinite-scroll .scroll-card:hover {
    transform: translateY(-4px) !important;
    opacity: 0.9 !important;
  }

  /* Mobile: Show exactly 2 cards at a time */
  @media screen and (max-width: 767px) {
    .infinite-scroll .scroll-card {
      width: calc(50vw - 16px) !important;
    }
  }
</style>

