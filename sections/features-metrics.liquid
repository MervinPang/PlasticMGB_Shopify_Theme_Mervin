<style>
  /* ── Base / Desktop: vh-relative sizing so content always fills 23vh ── */
  .features-metric-section {
    background-color: {{ section.settings.background_color }};
    padding: clamp(9px, 1.8vh, {{ section.settings.vertical_padding }}px) 20px;
    height: 23vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    box-sizing: border-box;
  }

  .features-metric-inner {
    width: 100%;
    max-width: 1200px;
  }

  .features-metric-section .features-metrics-heading {
    text-align: center;
    margin-bottom: clamp(2px, 0.4vh, 7px);
    font-size: clamp(10px, 1.3vh, 14px);
    font-weight: 700;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    line-height: 1.2;
  }

  .features-metric-section .features-metrics-subheading {
    text-align: center;
    margin-bottom: 0;
    font-size: clamp(16px, 2.3vh, 24px);
    font-weight: 700;
    color: {{ section.settings.text_color }};
    line-height: 1.2;
  }

  .features-metrics-header {
    text-align: center;
    margin-bottom: clamp(7px, 1.4vh, 20px);
  }

  .features-wrapper {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: clamp(5px, 1vh, 18px) 20px;
    text-align: center;
    padding-top: 0;
    max-width: 1100px;
    margin: 0 auto;
  }

  .features-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(2px, 0.4vh, 5px);
  }

  .features-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    font-size: clamp(23px, 4vh, 42px);
    font-weight: 800;
    line-height: 1;
    color: {{ section.settings.text_color }};
    margin-bottom: clamp(0px, 0.25vh, 3px);
  }

  .features-title-small {
    font-size: clamp(14px, 2vh, 22px);
    font-weight: 700;
    margin: 0 3px;
  }

  .features-title-suffix {
    font-size: clamp(14px, 2vh, 22px);
    font-weight: 700;
    flex-basis: 100%;
    text-align: center;
    margin-top: 2px;
  }

  .features-block > div:last-child {
    font-size: clamp(11px, 1.3vh, 15px);
    line-height: 1.3;
    color: {{ section.settings.text_color }};
    opacity: 0.75;
    max-width: 220px;
  }

  /* ── Fade-up scroll animation ── */
  @keyframes featuresFadeUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .features-fade-up {
    opacity: 0;
    transform: translateY(24px);
  }

  .features-fade-up.is-visible {
    animation: featuresFadeUp 0.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }


  /* ── Tablet: free-flowing height, 2-column grid ── */
  @media screen and (max-width: 768px) {
    .features-metric-section {
      height: auto;
      max-height: none;
      padding: 28px 16px;
    }

    .features-wrapper {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px 16px;
    }

    .features-title {
      font-size: 32px;
    }

    .features-title-small {
      font-size: 17px;
    }

    .features-title-suffix {
      font-size: 17px;
    }

    .features-metric-section .features-metrics-subheading {
      font-size: 20px;
    }

    .features-metrics-header {
      margin-bottom: 16px;
    }

    .features-block > div:last-child {
      font-size: 13px;
    }
  }

  /* ── Mobile: single-column, 4 compact rows ── */
  @media screen and (max-width: 480px) {
    .features-metric-section {
      height: auto;
      max-height: none;
      padding: 20px 16px;
    }

    .features-metric-section .features-metrics-heading {
      font-size: 11px;
      margin-bottom: 2px;
    }

    .features-metric-section .features-metrics-subheading {
      font-size: 16px;
    }

    .features-metrics-header {
      margin-bottom: 12px;
    }

    .features-wrapper {
      grid-template-columns: 1fr;
      grid-template-rows: repeat(4, auto);
      gap: 14px;
      justify-items: center;
      text-align: center;
    }

    .features-title {
      font-size: 28px;
    }

    .features-title-small {
      font-size: 15px;
    }

    .features-title-suffix {
      font-size: 15px;
    }

    .features-block {
      gap: 2px;
      align-items: center;
      text-align: center;
      width: 100%;
    }

    .features-block > div:last-child {
      font-size: 12px;
    }
  }
</style>

<section class="features-metric-section">
  <section class="features-metric-inner">
    <div class="container">
      {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
        <div class="features-metrics-header features-fade-up">
          {%- if section.settings.heading != blank -%}
            <div class="features-metrics-heading">{{ section.settings.heading }}</div>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <div class="features-metrics-subheading">{{ section.settings.subheading }}</div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="features-wrapper">
        {% for block in section.blocks %}
          <div class="features-block features-fade-up" style="animation-delay: {{ forloop.index0 | times: 120 }}ms;" {{ block.shopify_attributes }}>
            <div class="features-title">
              {%- if block.settings.metric_prefix != blank -%}
                <span class="features-title-small">{{ block.settings.metric_prefix }}</span>
              {%- endif -%}
              {{ block.settings.metric_value }}
              {%- if block.settings.metric_suffix != blank -%}
                <span class="features-title-suffix">{{ block.settings.metric_suffix }}</span>
              {%- endif -%}
            </div>
            <div>{{ block.settings.metric_description }}</div>
          </div>
        {% endfor %}
      </div>
    </div>
  </section>
</section>

<script>
  (function() {
    var els = document.querySelectorAll('.features-fade-up');
    if (!els.length) return;

    if ('IntersectionObserver' in window) {
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15 });

      els.forEach(function(el) {
        observer.observe(el);
      });
    } else {
      /* Fallback: show everything immediately */
      els.forEach(function(el) {
        el.classList.add('is-visible');
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Features & Metrics",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
