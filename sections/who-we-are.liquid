{%- if section.settings.background_image != blank -%}
  {%- assign bg_url = section.settings.background_image | image_url: width: 2000 -%}
{%- else -%}
  {%- assign bg_url = 'Two_bins_low_angle_202606081435.jpeg' | asset_url -%}
{%- endif -%}

<style>
  .who-we-are-{{ section.id }} {
    position: relative;
    overflow: hidden;
  }

  .who-we-are-{{ section.id }} .who-we-are__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-size: cover;
    background-position: {{ section.settings.bg_position | default: 'center center' }};
    background-repeat: no-repeat;
  }

  .who-we-are-{{ section.id }} .who-we-are__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: {{ section.settings.overlay_color | default: 'rgba(0,0,0,0.55)' }};
    opacity: {{ section.settings.overlay_opacity | default: 55 | divided_by: 100.0 }};
  }

  .who-we-are-{{ section.id }} .div-block-8 {
    position: relative;
    z-index: 2;
  }
</style>

<section class="section-8 who-we-are-{{ section.id }}">
  <div class="who-we-are__bg" style="background-image: url('{{ bg_url }}');"></div>
  <div class="who-we-are__overlay"></div>

  <div class="div-block-8">
    <div class="div-block-9">
      {%- assign eyebrow = section.settings.eyebrow -%}
      {%- if eyebrow == blank or eyebrow == 'WHO WE ARE' -%}
        {%- assign eyebrow = 'sections.who_we_are.eyebrow' | t -%}
      {%- endif -%}
      {%- assign heading = section.settings.heading -%}
      {%- if heading == blank or heading == 'A manufacturer built on precision and long-term partnerships' -%}
        {%- assign heading = 'sections.who_we_are.heading' | t -%}
      {%- endif -%}
      {%- assign description = section.settings.description -%}
      {%- assign default_desc = 'Plastic MGB Co. Ltd was established in 2011 as a division of a larger wheel and castor manufacturing group based in Guangdong, China. From the outset, the business focused exclusively on accessories for mobile garbage bins — a specialist niche demanding exacting standards in load capacity, material durability and dimensional consistency.<br><br>Today we produce over 5 million castor wheels and 8 million steel axles annually, supplying OEM manufacturers across Europe, Asia Pacific, the Middle East and the Americas. MGB accessories are all we do — and that focus is what makes us the right partner for serious OEM buyers.' -%}
      {%- if description == blank or description == default_desc -%}
        {%- assign description = 'sections.who_we_are.description_html' | t -%}
      {%- endif -%}

      <div>
        <div class="eyebrow">
          <svg width="100%" height="100%" fill="none" xmlns="http://www.w3.org/2000/svg" viewbox="0 0 16 16" class="svg-2">
            <path fill-rule="evenodd" d="M2 8a.5.5 0 0 1 .5-.5h11a.5.5 0 0 1 0 1h-11A.5.5 0 0 1 2 8Z" fill="currentColor" class="path"></path>
          </svg>
          <h1 class="heading-6"><strong class="bold-text-4">{{ eyebrow }}</strong></h1>
        </div>
      </div>
      <h1 class="heading-7"><strong class="bold-text-2">{{ heading }}</strong></h1>
      <div class="text-block-8-copy">{{ description }}</div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Who We Are",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "WHO WE ARE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A manufacturer built on precision and long-term partnerships"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "header",
      "content": "Background Image"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "select",
      "id": "bg_position",
      "label": "Image focal point",
      "options": [
        { "value": "center top", "label": "Top" },
        { "value": "center center", "label": "Centre" },
        { "value": "center bottom", "label": "Bottom" },
        { "value": "left center", "label": "Left" },
        { "value": "right center", "label": "Right" }
      ],
      "default": "center center"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay colour",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 55
    }
  ],
  "presets": [
    {
      "name": "Who We Are"
    }
  ]
}
{% endschema %}
