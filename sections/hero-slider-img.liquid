{% comment %}
  ------------------------------------------------------------------------------
  Section: Hero Slider (Fully Localized & Shopify Translate & Adapt Ready)
  Description: Premium B2B industrial hero for PlasticMGB. Exposes all text strings 
               via Shopify translation filters (| t) and Section Settings / Schema blocks,
               making 100% of the section translatable via Translate & Adapt without code edits.
  ------------------------------------------------------------------------------
{% endcomment %}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --hero-bg-color: #090e1a;
    --hero-navy: #133f90;
    --hero-gold: #ffc107;
    --hero-dark-card: #0a0f1d;
    --hero-border: rgba(255, 255, 255, 0.25);
  }

  .cat-hero-section-{{ section.id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: var(--hero-bg-color);
    color: #ffffff;
    font-family: 'Exo', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .cat-hero-container {
    position: relative;
    width: 100%;
    margin: 0 auto;
    overflow: hidden;
  }

  /* ── Widescreen Compact Hero Viewport ── */
  .cat-hero__viewport {
    position: relative;
    width: 100%;
    min-height: 460px;
  }

@media screen and (min-width: 992px) {
  .cat-hero__viewport {
    height: clamp(480px, 78vh, 900px);
    min-height: 480px;
  }
}

  .cat-hero__track {
    display: flex;
    width: 100%;
    height: 100%;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cat-hero--fade .cat-hero__track {
    display: grid;
    grid-template-areas: "slide";
    transition: none;
  }

  .cat-hero__slide {
    padding-top: 10vh;
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
  }

  .cat-hero--fade .cat-hero__slide {
    grid-area: slide;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.8s ease, visibility 0.8s ease;
    z-index: 1;
  }

  .cat-hero--fade .cat-hero__slide.is-active {
    opacity: 1;
    visibility: visible;
    z-index: 2;
  }

  /* ── Background Media & Dark Industrial Overlay ── */
  .cat-hero__bg-wrap {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .cat-hero__video,
  .cat-hero__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .cat-hero__fallback-bg {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #070c18 0%, #133f90 60%, #0f172a 100%);
  }

  .cat-hero__overlay {
    position: absolute;
    inset: 0;
    background: 
      linear-gradient(to right, rgba(7, 12, 24, 0.92) 0%, rgba(7, 12, 24, 0.8) 45%, rgba(7, 12, 24, 0.5) 75%, rgba(7, 12, 24, 0.75) 100%),
      linear-gradient(to bottom, rgba(7, 12, 24, 0.25) 0%, transparent 50%, rgba(7, 12, 24, 0.75) 100%);
    z-index: 2;
    pointer-events: none;
  }

  /* ── Split Layout: Left 48% Copy / Right 52% Unified Product Explorer ── */
  .cat-hero__content-box {
    position: relative;
    z-index: 3;
    width: 100%;
    height: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: clamp(1.5rem, 3vw, 2.75rem) clamp(1.5rem, 4vw, 4rem);
    display: grid;
    grid-template-columns: 48% 52%;
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: center;
    box-sizing: border-box;
  }

  /* ── Left Column: Company Messaging & Action CTAs ── */
  .cat-hero__left-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 580px;
    z-index: 4;
  }

  /* Eyebrow Badge */
  .cat-hero__label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78125rem; /* 12.5px */
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--hero-gold);
    margin-bottom: 0.5rem;
    background: rgba(255, 193, 7, 0.15);
    border: 1px solid rgba(255, 193, 7, 0.4);
    padding: 4px 12px;
    border-radius: 4px;
    width: fit-content;
  }

  /* Headline */
  .cat-hero__headline {
    font-size: clamp(1.75rem, 2.5vw, 2.65rem);
    font-weight: 800;
    line-height: 1.16;
    letter-spacing: -0.015em;
    color: #ffffff;
    text-transform: none;
    margin: 0 0 0.65rem;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.4);
  }

  /* Description */
  .cat-hero__subtext {
    font-size: clamp(0.925rem, 1vw, 1.025rem);
    line-height: 1.55;
    color: rgba(241, 245, 249, 0.92);
    margin-bottom: 1.25rem;
    font-weight: 400;
  }

  /* Action Buttons */
  .cat-hero__actions {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .cat-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 24px;
    border-radius: 6px;
    font-size: 0.9375rem; /* 15px */
    font-weight: 800;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: all 0.25s ease;
    cursor: pointer;
    white-space: nowrap;
    box-sizing: border-box;
  }

  .cat-hero__btn--primary {
    background-color: #ffc107;
    color: #070c18;
    border: 2px solid #ffc107;
    box-shadow: 0 4px 18px rgba(255, 193, 7, 0.45);
  }

  .cat-hero__btn--primary:hover {
    background-color: #ffd54f;
    border-color: #ffd54f;
    transform: translateY(-2px);
    box-shadow: 0 6px 22px rgba(255, 193, 7, 0.6);
  }

  .cat-hero__btn--secondary {
    background-color: rgba(255, 255, 255, 0.18);
    color: #ffffff;
    border: 2px solid rgba(255, 255, 255, 0.65);
    backdrop-filter: blur(10px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
  }

  .cat-hero__btn--secondary:hover {
    background-color: #ffffff;
    color: #070c18;
    border-color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(255, 255, 255, 0.3);
  }

  .cat-hero__trust-badge {
    font-size: 0.78125rem;
    color: rgba(241, 245, 249, 0.8);
    display: flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  /* ─────────────────────────────────────────────────────────────
     RIGHT 52% COLUMN: UNIFIED PRODUCT EXPLORER COMPONENT
     ───────────────────────────────────────────────────────────── */
  .cat-hero__info-panel-wrap {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 4;
  }

  /* Product Information Card */
  .cat-hero__info-panel {
    position: relative;
    width: 100%;
    max-width: 580px;
    min-height: 270px;
    background: rgba(11, 19, 41, 0.75);
    backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 14px;
    box-sizing: border-box;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.5);
    overflow: hidden;
    transition: height 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94), box-shadow 0.3s ease;
  }

  /* Individual Product Information Slide */
  .cat-info-slide {
    display: grid;
    grid-template-columns: 42% 58%;
    gap: 14px;
    align-items: center;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    min-height: 100%;
    padding: 16px 18px;
    box-sizing: border-box;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.3s ease-in-out, transform 0.3s ease-in-out;
    pointer-events: none;
  }

  .cat-info-slide.is-active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .cat-info-slide__stage {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: radial-gradient(circle at center, rgba(19, 63, 144, 0.35) 0%, transparent 75%);
    border-radius: 10px;
  }

  .cat-info-slide__img {
    max-width: 90%;
    max-height: 90%;
    object-fit: contain;
    filter: drop-shadow(0 14px 24px rgba(0, 0, 0, 0.65));
    transition: transform 0.3s ease;
  }

  .cat-info-slide__shadow {
    position: absolute;
    bottom: 6px;
    width: 65%;
    height: 10px;
    background: radial-gradient(ellipse at center, rgba(0,0,0,0.6) 0%, transparent 75%);
    border-radius: 50%;
    pointer-events: none;
  }

  .cat-info-slide__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 8px;
    color: #ffffff;
  }

  .cat-info-slide__title {
    font-size: 1.15rem; /* 18.5px */
    font-weight: 800;
    color: #ffffff;
    line-height: 1.25;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .cat-info-slide__desc {
    font-size: 0.78125rem; /* 12.5px */
    line-height: 1.45;
    color: rgba(241, 245, 249, 0.85);
    margin: 0;
    font-weight: 400;
  }

  /* Specification Badges */
  .cat-info-slide__specs {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-top: 4px;
  }

  .cat-spec-chip {
    font-size: 0.6875rem; /* 11px */
    font-weight: 700;
    color: var(--hero-gold);
    background: rgba(255, 193, 7, 0.12);
    border: 1px solid rgba(255, 193, 7, 0.3);
    padding: 3px 7px;
    border-radius: 4px;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  /* View Product Link CTA */
  .cat-info-slide__link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.8125rem; /* 13px */
    font-weight: 800;
    color: #ffffff;
    text-decoration: none;
    margin-top: 6px;
    transition: color 0.25s ease, transform 0.25s ease;
    width: fit-content;
  }

  .cat-info-slide__link:hover {
    color: var(--hero-gold);
    transform: translateX(3px);
  }

  /* Product Selector Chips Bar */
  .cat-hero__prod-nav-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    max-width: 580px;
    margin-top: 20px;
    box-sizing: border-box;
  }

  .cat-prod-chip {
    flex: 1 1 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 9px 12px;
    background: rgba(15, 25, 50, 0.75);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 10px;
    text-decoration: none;
    color: #ffffff;
    font-size: 0.8125rem; /* 13px */
    font-weight: 700;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    box-sizing: border-box;
    white-space: nowrap;
    text-align: center;
  }

  .cat-prod-chip:hover {
    background: rgba(19, 63, 144, 0.6);
    border-color: rgba(255, 193, 7, 0.7);
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 5px 16px rgba(0, 0, 0, 0.35);
  }

  .cat-prod-chip.is-active {
    background: rgba(19, 63, 144, 0.88);
    border-color: #ffc107;
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(255, 193, 7, 0.35);
  }

  .cat-prod-chip__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.5);
    flex-shrink: 0;
    transition: background 0.25s ease, transform 0.25s ease;
  }

  .cat-prod-chip:hover .cat-prod-chip__dot,
  .cat-prod-chip.is-active .cat-prod-chip__dot {
    background: #ffc107;
    transform: scale(1.25);
  }

  /* Subdued Slider Controls */
  .cat-hero__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 12;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(7, 12, 24, 0.6);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    opacity: 0.75;
    transition: all 0.3s ease;
  }

  .cat-hero__arrow:hover {
    opacity: 1;
    background: var(--hero-navy);
    border-color: var(--hero-gold);
  }

  .cat-hero__arrow--prev { left: 16px; }
  .cat-hero__arrow--next { right: 16px; }

  .cat-hero__pagination {
    position: absolute;
    bottom: 12px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 12;
    display: flex;
    gap: 6px;
    align-items: center;
  }

  .cat-hero__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.4);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .cat-hero__dot.is-active {
    width: 24px;
    border-radius: 999px;
    background: var(--hero-gold);
  }

  /* ── Responsive Mobile & Tablet Layouts ── */
  @media screen and (max-width: 991px) {
    .cat-hero__viewport {
      height: auto;
      min-height: 460px;
    }

    .cat-hero__content-box {
      grid-template-columns: 100%;
      gap: 2rem;
    }

    .cat-hero__left-content {
      max-width: 100%;
      text-align: center;
      align-items: center;
    }

    .cat-hero__actions {
      justify-content: center;
    }

    .cat-hero__info-panel {
      min-height: 270px;
    }

    .cat-info-slide {
      grid-template-columns: 40% 60%;
      padding: 14px 16px;
    }

    .cat-hero__prod-nav-row {
      overflow-x: auto;
      justify-content: flex-start;
      padding-bottom: 6px;
    }

    .cat-prod-chip {
      flex: 0 0 auto;
    }
  }

  @media screen and (max-width: 640px) {
    .cat-hero__content-box {
      padding: 1.5rem 1rem 1.25rem;
    }

    .cat-hero__headline {
      font-size: 1.5rem;
    }

    .cat-hero__subtext {
      font-size: 0.875rem;
    }

    .cat-hero__btn {
      width: 100%;
      max-width: 280px;
    }

    .cat-info-slide {
      grid-template-columns: 100%;
      position: relative;
      inset: auto;
      opacity: 1;
      transform: none;
    }

    .cat-info-slide:not(.is-active) {
      display: none;
    }

    .cat-hero__info-panel {
      min-height: auto;
    }
  }
{%- endstyle -%}

<div class="cat-hero-section-{{ section.id }}" data-hero-slider-section="{{ section.id }}">
  <div class="cat-hero-container">
    <div
      class="cat-hero__viewport cat-hero--{{ section.settings.transition_style | default: 'slide' }}"
      id="HeroSlider-{{ section.id }}"
      role="region"
      aria-roledescription="carousel"
      aria-label="{{ section.settings.accessibility_label | escape | default: 'accessibility.hero_carousel' | t }}"
      data-autoplay="{{ section.settings.autoplay | default: true }}"
      data-speed="{{ section.settings.autoplay_speed | times: 1000 | default: 5000 }}"
      data-infinite="{{ section.settings.infinite_loop | default: true }}"
    >
      <div class="cat-hero__track" data-slider-track>
        {%- for block in section.blocks -%}
          {%- if block.type == 'slide' -%}
            {%- assign slide_text_color = block.settings.text_color | default: '#ffffff' -%}

            <div
              class="cat-hero__slide{% if forloop.first %} is-active{% endif %}"
              id="Slide-{{ section.id }}-{{ block.id }}"
              role="group"
              aria-roledescription="slide"
              aria-label="{{ forloop.index }} of {{ section.blocks.size }}"
              {{ block.shopify_attributes }}
              style="color: {{ slide_text_color }};"
            >
              <!-- Background Media & Dark Industrial Overlay -->
              <div class="cat-hero__bg-wrap">
                {%- if block.settings.video_mp4 != blank or block.settings.video_webm != blank -%}
                  <video
                    class="cat-hero__video"
                    autoplay
                    loop
                    muted
                    playsinline
                    {% if block.settings.poster != blank %}poster="{{ block.settings.poster | asset_url }}"{% endif %}
                  >
                    {%- if block.settings.video_mp4 != blank -%}
                      <source src="{{ block.settings.video_mp4 | asset_url }}" type="video/mp4">
                    {%- endif -%}
                    {%- if block.settings.video_webm != blank -%}
                      <source src="{{ block.settings.video_webm | asset_url }}" type="video/webm">
                    {%- endif -%}
                  </video>
                {%- elsif block.settings.image != blank or block.settings.desktop_image != blank -%}
                  {%- assign slide_img = block.settings.image | default: block.settings.desktop_image -%}
                  <img
                    src="{{ slide_img | image_url: width: 1920 }}"
                    srcset="
                      {{ slide_img | image_url: width: 1000 }} 1000w,
                      {{ slide_img | image_url: width: 1920 }} 1920w
                    "
                    sizes="100vw"
                    alt="{{ block.settings.heading | escape }}"
                    class="cat-hero__bg-img"
                    {% unless forloop.first %}loading="lazy"{% endunless %}
                  >
                {%- else -%}
                  <div class="cat-hero__fallback-bg"></div>
                {%- endif -%}

                <div class="cat-hero__overlay"></div>
              </div>

              <!-- Main Horizontal Hero Content Box (Left 48% / Right 52%) -->
              <div class="cat-hero__content-box">
                <!-- Left 48%: Company Messaging, CTAs, & Trust Badge -->
                <div class="cat-hero__left-content">

                  {%- assign slide_heading = block.settings.heading -%}
                  {%- if slide_heading == blank or slide_heading == 'BUILT FOR PERFORMANCE' or slide_heading == 'Heavy-Duty MGB Components Engineered for Global OEM Manufacturers' -%}
                    {%- assign slide_heading = 'sections.hero.heading' | t -%}
                  {%- endif -%}
                  <h1 class="cat-hero__headline">{{ slide_heading }}</h1>

                  {%- assign slide_desc = block.settings.description -%}
                  {%- if slide_desc == blank or slide_desc contains 'Precision-engineered castors' or slide_desc contains 'We manufacture high-capacity' -%}
                    {%- assign slide_desc = 'sections.hero.description' | t -%}
                  {%- endif -%}
                  <div class="cat-hero__subtext">
                    {{ slide_desc }}
                  </div>

                  {%- assign primary_text = block.settings.button_text | default: block.settings.button_primary_text -%}
                  {%- if primary_text == blank or primary_text == '→ Specifications' or primary_text == 'Request a Quote' -%}
                    {%- assign primary_text = 'sections.hero.request_quote' | t -%}
                  {%- endif -%}
                  {%- assign primary_url = block.settings.button_url | default: block.settings.button_primary_url | default: '/pages/contact-us' -%}

                  {%- assign secondary_text = block.settings.button_secondary_text -%}
                  {%- if secondary_text == blank or secondary_text == 'View Components' -%}
                    {%- assign secondary_text = 'sections.hero.view_components' | t -%}
                  {%- endif -%}
                  {%- assign secondary_url = block.settings.button_secondary_url | default: '/collections/all' -%}

                  {%- assign trust_badge_text = 'sections.hero.trust_badge' | t -%}
                  {%- if section.settings.trust_badge_text != blank and section.settings.trust_badge_text != 'Trusted supplier to leading mobile waste bin manufacturers worldwide.' -%}
                    {%- assign trust_badge_text = section.settings.trust_badge_text -%}
                  {%- endif -%}

                  {%- assign view_prod_link_label = 'sections.hero.view_product' | t -%}
                  {%- if section.settings.view_product_label != blank and section.settings.view_product_label != 'View Product' -%}
                    {%- assign view_prod_link_label = section.settings.view_product_label -%}
                  {%- endif -%}

                  <div class="cat-hero__actions">
                    <a href="{{ primary_url }}" class="cat-hero__btn cat-hero__btn--primary">
                      {{ primary_text }}
                    </a>
                    <a href="{{ secondary_url }}" class="cat-hero__btn cat-hero__btn--secondary">
                      {{ secondary_text }}
                    </a>
                  </div>

                  <div class="cat-hero__trust-badge">
                    <span style="color: var(--hero-gold);">✓</span>
                    <span>{{ trust_badge_text }}</span>
                  </div>
                </div>

                <!-- Right 52%: Unified Product Explorer (Preview Panel + Selector Chips Directly Below) -->
                <div class="cat-hero__info-panel-wrap">
                  <!-- Product Information Card -->
                  <div class="cat-hero__info-panel">
                    <!-- Product 1: Heavy Duty Castor -->
                    <div class="cat-info-slide is-active" id="panel-0" role="tabpanel" data-prod-info="0">
                      <div class="cat-info-slide__stage">
                        <img src="{{ 'Heavy-Duty.png' | asset_url }}" alt="{{ 'products.names.heavy_duty_Castor' | t | escape }}" class="cat-info-slide__img" loading="eager">
                        <div class="cat-info-slide__shadow"></div>
                      </div>
                      <div class="cat-info-slide__content">
                        <h3 class="cat-info-slide__title">{{ 'products.names.heavy_duty_Castor' | t | default: 'Heavy Duty Castor' }}</h3>
                        <p class="cat-info-slide__desc">{{ 'sections.hero.products.Castor_desc' | t | default: 'EN840/RAL 951 Certified. Fixed/Swivel castor, fork and plate made of heavy pressed steel that is reinforced and zinc plated. Wheel centre made of polypropylene. heavy duty, precision ball bearing.' }}</p>
                        <div class="cat-info-slide__specs">
                          <span class="cat-spec-chip">{{ 'sections.hero.specs.en840_certified' | t | default: 'EN840/RAL 951 Certified' }}</span>
                          <span class="cat-spec-chip">{{ 'sections.hero.specs.Castor_sizes' | t | default: 'Polypropylene Core' }}</span>
                          <span class="cat-spec-chip">{{ 'sections.hero.specs.swivel_fixed' | t | default: 'Swivel & Fixed' }}</span>
                          <span class="cat-spec-chip">{{ 'sections.hero.specs.zinc_plated_fork' | t | default: 'Zinc-Plated Fork and Plate' }}</span>
                        </div>
                        <a href="{{ all_products['heavy-duty-Castor'].url | default: '/products/heavy-duty-Castor' }}" class="cat-info-slide__link">
                          <span>{{ view_prod_link_label }}</span>
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                        </a>
                      </div>
                    </div>

                    <!-- Product 2: Steel Axle -->
