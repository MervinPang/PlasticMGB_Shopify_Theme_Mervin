<script>
  (function() {
    /* ── 1. Interactive Product Information Panel Logic ── */
    function initInteractiveShowcase(container) {
      var triggers = container.querySelectorAll('[data-prod-trigger]');
      var panels = container.querySelectorAll('[data-prod-info]');
      var infoPanel = container.querySelector('.cat-hero__info-panel');
      if (!triggers.length || !panels.length) return;

      function updatePanelHeight() {
        if (!infoPanel || window.innerWidth <= 640) {
          if (infoPanel) infoPanel.style.height = '';
          return;
        }
        var activeSlide = container.querySelector('.cat-info-slide.is-active');
        if (activeSlide) {
          var h = activeSlide.offsetHeight || activeSlide.scrollHeight;
          if (h > 0) {
            infoPanel.style.height = Math.max(270, h) + 'px';
          }
        }
      }

      function setActive(idx) {
        triggers.forEach(function(chip, i) {
          var isMatch = (i === idx);
          chip.classList.toggle('is-active', isMatch);
          chip.setAttribute('aria-selected', isMatch ? 'true' : 'false');
        });
        panels.forEach(function(panel, i) {
          panel.classList.toggle('is-active', i === idx);
        });
        setTimeout(updatePanelHeight, 20);
      }

      triggers.forEach(function(chip) {
        var idx = parseInt(chip.getAttribute('data-prod-trigger'), 10);
        chip.addEventListener('mouseenter', function() { setActive(idx); });
        chip.addEventListener('focus', function() { setActive(idx); });
        chip.addEventListener('click', function() { setActive(idx); });
      });

      setActive(0);
      window.addEventListener('resize', updatePanelHeight);
    }

    /* ── 2. Hero Slider Instance ── */
    class CatHeroSlider {
      constructor(container) {
        this.container = container;
        this.viewport = container.querySelector('#HeroSlider-{{ section.id }}');
        this.track = container.querySelector('[data-slider-track]');
        this.slides = container.querySelectorAll('.cat-hero__slide');
        this.dots = container.querySelectorAll('[data-slider-dot]');
        this.prevBtn = container.querySelector('[data-slider-prev]');
        this.nextBtn = container.querySelector('[data-slider-next]');
        
        initInteractiveShowcase(container);

        if (!this.slides || this.slides.length <= 1) return;

        this.currentIndex = 0;
        this.isAutoplay = this.viewport.dataset.autoplay === 'true';
        this.speed = parseInt(this.viewport.dataset.speed) || 5000;
        this.isInfinite = this.viewport.dataset.infinite === 'true';
        this.timer = null;

        this.init();
      }

      init() {
        if (this.prevBtn) this.prevBtn.addEventListener('click', () => this.prev());
        if (this.nextBtn) this.nextBtn.addEventListener('click', () => this.next());

        this.dots.forEach((dot, index) => {
          dot.addEventListener('click', () => this.goTo(index));
        });

        // Touch gestures
        let startX = 0;
        this.viewport.addEventListener('touchstart', (e) => {
          startX = e.touches[0].clientX;
        }, { passive: true });

        this.viewport.addEventListener('touchend', (e) => {
          let endX = e.changedTouches[0].clientX;
          if (startX - endX > 50) this.next();
          if (endX - startX > 50) this.prev();
        }, { passive: true });

        // Keyboard navigation
        this.viewport.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight') this.next();
          if (e.key === 'ArrowLeft') this.prev();
        });

        if (this.isAutoplay) {
          this.startAutoplay();
          this.viewport.addEventListener('mouseenter', () => this.stopAutoplay());
          this.viewport.addEventListener('mouseleave', () => this.startAutoplay());
        }
      }

      goTo(index) {
        if (index < 0) index = this.isInfinite ? this.slides.length - 1 : 0;
        if (index >= this.slides.length) index = this.isInfinite ? 0 : this.slides.length - 1;

        this.currentIndex = index;

        if (this.viewport.classList.contains('cat-hero--fade')) {
          this.slides.forEach((slide, i) => {
            slide.classList.toggle('is-active', i === index);
          });
        } else {
          this.track.style.transform = `translateX(-${index * 100}%)`;
          this.slides.forEach((slide, i) => slide.classList.toggle('is-active', i === index));
        }

        this.dots.forEach((dot, i) => {
          dot.classList.toggle('is-active', i === index);
        });
      }

      next() {
        this.goTo(this.currentIndex + 1);
      }

      prev() {
        this.goTo(this.currentIndex - 1);
      }

      startAutoplay() {
        this.stopAutoplay();
        this.timer = setInterval(() => this.next(), this.speed);
      }

      stopAutoplay() {
        if (this.timer) clearInterval(this.timer);
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      const sectionEl = document.querySelector('.cat-hero-section-{{ section.id }}');
      if (sectionEl) new CatHeroSlider(sectionEl);
    });

    if (window.Shopify && Shopify.designMode) {
      document.addEventListener('shopify:section:load', (e) => {
        if (e.detail.sectionId === '{{ section.id }}') {
          new CatHeroSlider(e.target);
        }
      });
    }
  })();
</script>

